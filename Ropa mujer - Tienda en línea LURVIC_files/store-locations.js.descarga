const BACKEND_BASE_URL_STATIC = "https://app.getstorelocator.com";
let shopUrlStatic = "";
let storeLocationsStatic = [];
let filteredStoreLocationsStatic = [];
let storeCoordinatesStatic = {};
let storeIndexMapStatic = new Map();
let isExpandedStateStatic = {};
let selectedStoreIdStatic = null;
let settingsStatic = {};
let isStoresListCollapsedStatic = false;
let storesListMediaQueryStatic = null;
let storesListListenerStatic = null;
let mapIframeReadyStatic = false;
let hasPendingMapSelectionStatic = false;

window.addEventListener("message", (event) => {
    if (!event.data || event.data.type !== "snts:storeClicked") return;
    const locatorForClick = document.querySelector('[data-effectify-store-locator]:not([data-is-duplicate])');
    const sectionForClick = locatorForClick ? locatorForClick.dataset.sectionId : null;
    const mapFrameStatic = sectionForClick ? document.getElementById(`google-map-iframe-static-${sectionForClick}`) : null;
    if (mapFrameStatic && event.source === mapFrameStatic.contentWindow) selectStoreFromMapStatic(event.data.storeId);
});

window.addEventListener("message", (event) => {
    if (!event.data || event.data.type !== "snts:mapReady") return;
    const locator = document.querySelector('[data-effectify-store-locator]:not([data-is-duplicate])');
    const sectionId = locator ? locator.dataset.sectionId : null;
    if (!sectionId) return;
    const iframeStatic = document.getElementById(`google-map-iframe-static-${sectionId}`);
    if (iframeStatic && event.source === iframeStatic.contentWindow) {
        mapIframeReadyStatic = true;
        if (hasPendingMapSelectionStatic) {
            hasPendingMapSelectionStatic = false;
            sendSelectedStoreToIframeStatic(iframeStatic);
        }
    }
});

document.addEventListener("keydown", (event) => {
    if (event.key !== "Enter" && event.key !== " ") return;
    const target = event.target;
    if (!(target instanceof HTMLElement) || target.getAttribute("role") !== "button") return;
    if (!target.closest("[data-effectify-store-locator]")) return;
    event.preventDefault();
    if (!event.repeat) target.click();
});

function sendSelectedStoreToIframeStatic(iframeStatic) {
    if (!iframeStatic || !iframeStatic.contentWindow) return;
    iframeStatic.contentWindow.postMessage({type: "snts:selectStore", storeId: selectedStoreIdStatic || null}, BACKEND_BASE_URL_STATIC);
}

function getTodayHoursStatusStatic(hours) {
    if (!Array.isArray(hours) || hours.length === 0) return null;
    const todayIdx = new Date().getDay();
    const today = hours[todayIdx];
    if (!today) return null;
    if (!today.closed && today.opens && today.closes) {
        const [oh, om] = today.opens.split(':').map(Number);
        const [ch, cm] = today.closes.split(':').map(Number);
        const nowMin = new Date().getHours() * 60 + new Date().getMinutes();
        const isAllDay = today.opens === '00:00' && today.closes === '00:00';
        const openNow = isAllDay || (nowMin >= oh * 60 + om && nowMin < ch * 60 + cm);
        if (openNow) return {isOpen: true, closes: today.closes, isAllDay};
    }
    if (today.closed || (today.opens && today.closes)) {
        if (!today.closed && today.opens) {
            const [oh, om] = today.opens.split(':').map(Number);
            const nowMin = new Date().getHours() * 60 + new Date().getMinutes();
            if (nowMin < oh * 60 + om) {
                return {isOpen: false, nextOpen: {dayIdx: todayIdx, day: today.day, opens: today.opens}};
            }
        }
        for (let i = 1; i <= 7; i++) {
            const next = hours[(todayIdx + i) % 7];
            if (next && !next.closed && next.opens) {
                return {isOpen: false, nextOpen: {dayIdx: (todayIdx + i) % 7, day: next.day, opens: next.opens}};
            }
        }
        return {isOpen: false};
    }
    return {isUnspecified: true};
}

const initEffectifyStatic = () => {
    SNTSStaticMainFunction().catch((error) => {
        console.error("SNTS Static Store Locator failed to initialize", error);
        setMapMessageStatic("Unable to load map.");
    });
};

if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initEffectifyStatic);
} else {
    initEffectifyStatic();
}

async function SNTSStaticMainFunction() {
    shopUrlStatic = window.Shopify?.shop || "";
    setMapMessageStatic("Loading map...");

    const controller = new AbortController();
    const timeoutId = setTimeout(() => controller.abort(), 10000);

    try {
        const locatorSettings = await fetch(`${BACKEND_BASE_URL_STATIC}/get_locator_settings?shop_url=${encodeURIComponent(shopUrlStatic)}`, {
            method: "GET",
            mode: "cors",
            headers: { "ngrok-skip-browser-warning": "true" },
            signal: controller.signal,
        });
        clearTimeout(timeoutId);

        if (!locatorSettings.ok) {
            console.warn("Failed to fetch locator settings");
            setMapMessageStatic("Unable to load map.");
            return;
        }

        const response = await locatorSettings.json();
        settingsStatic = response.result || {};
    } catch (error) {
        clearTimeout(timeoutId);
        if (error.name === "AbortError") {
            setMapMessageStatic("Request timed out.");
        } else {
            setMapMessageStatic("Unable to load map.");
        }
        console.error("Error fetching locator settings", error);
        return;
    }

    const shopifyObj = window.Shopify || {};
    const isThemeEditor = shopifyObj.designMode === true || shopifyObj.visualPreviewMode === true;
    const isFreePlan = settingsStatic.plan_id === 3;

    const locators = document.querySelectorAll('[data-effectify-store-locator]');
    if (isThemeEditor) {
        locators.forEach(el => {
            el.style.display = 'flex';
        })
    } else {
        if (!isFreePlan && locators.length) {
            const firstLocator = locators[0];
            firstLocator.style.display = 'flex';
        }
    }

    if (isFreePlan && isThemeEditor) {
        showUpgradeBanner();
        const storeLocationsHeader = document.getElementById("storeLocationsHeader-static");
        const storeLocationsContainer = document.getElementById("storesContainer-static");
        if (storeLocationsHeader) {
            storeLocationsHeader.style.opacity = "0.5";
        }
        
        if (storeLocationsContainer) {
            storeLocationsContainer.style.opacity = "0.5";
        }
    }

    if (settingsStatic.store_locations.length === 0) {
        if (!isFreePlan && isThemeEditor) {
            showAddStoreLocationsBanner();
        } else {
            locators.forEach(element => {
                element.remove();
            });
        }
        return;
    }

    applyThemeSettingsStatic();
    initializeStoreDataStatic();
    attachSearchHandlerStatic();
    renderStoresListStatic();
    setupResponsiveStoresListStatic();
    updateMapIframeStatic();
}

function applyThemeSettingsStatic() {
    const locatorHeader = document.getElementById("locatorHeader-static");
    const storeLocationsHeader = document.getElementById("storeLocationsHeader-static");
    const storesList = document.getElementById("storesListContainer-static");
    const searchResultElement = document.getElementById("searchResultsCount-static");

    if (!locatorHeader || !storesList || !searchResultElement) {
        return false;
    }

    const searchInput = document.getElementById("storeSearchInput-static");
    if (searchInput && settingsStatic.nav_search_placeholder) {
        searchInput.placeholder = settingsStatic.nav_search_placeholder;
    }

    const backgroundColor = getColorSettingStatic(settingsStatic.nav_background_color, "f6f6f7");
    const titleColor = getColorSettingStatic(settingsStatic.nav_title_color, "1e2433");
    const secondaryColor = getColorSettingStatic(settingsStatic.nav_secondary_text_color, "6d7175");

    storeLocationsHeader.style.backgroundColor = `#${backgroundColor}`;
    locatorHeader.innerText = settingsStatic.nav_title || "Store locations";
    locatorHeader.style.color = `#${titleColor}`;
    storesList.style.backgroundColor = `#${backgroundColor}`;
    const resizeHandleStatic = document.getElementById("storesResizer-static");
    if (resizeHandleStatic) resizeHandleStatic.style.backgroundColor = `#${backgroundColor}`;
    searchResultElement.style.color = `#${secondaryColor}`;

    if (settingsStatic.nav_custom_css) {
        const styleElement = document.createElement("style");
        styleElement.type = "text/css";
        styleElement.innerHTML = settingsStatic.nav_custom_css;
        document.head.appendChild(styleElement);
    }

    return true;
}

function showUpgradeBanner() {
    document.querySelectorAll('[data-effectify-store-locator]').forEach((el) => {
        if (el.querySelector('.effectify-warning')) return; 
        
        const shopName = window.Shopify?.shop.split('.')[0] || 'admin';
        const planUrl = `https://admin.shopify.com/store/${shopName}/apps/sticky-navigate-to-store/account-settings`;
    
        const warningHTML = `
          <div class="upgrade-plan-warning">
            <div class="locator-banner-header">
                <span class="locator-banner-icons">
                    <svg viewBox="0 0 20 20" class="locator-icon-svg" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <path d="M6.75 8V6.5C6.75 4.70507 8.20507 3.25 10 3.25C11.7949 3.25 13.25 4.70507 13.25 6.5V8" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                        <rect x="4.75" y="8" width="10.5" height="8.75" rx="1.25" stroke="currentColor" stroke-width="1.5"/>
                    </svg>
                </span>
                <span class="locator-banner-notice">This banner is only visible to you</span>
            </div>
            
            <div class="locator-banner-content">
                <span class="locator-banner-label">Plan Upgrade Required:</span>
                <span class="locator-banner-text">You are previewing the Store Locator block. To display it on your live store, please upgrade your plan.</span>
            </div>

            <div class="locator-banner-footer">
                <div class="footer-button-container">
                    <a href="${planUrl}" 
                        target="_blank" 
                        class="polaris-btn-primary-dark" 
                        onclick="event.stopPropagation(); window.open(this.href, '_blank'); return false;">
                        Upgrade Now
                    </a>
                </div>
                <img src="https://cdn.shopify.com/s/files/1/0937/6428/8833/files/drive-to-us-sticky-navigator.png?v=1773149888" class="drive-to-us-sticky-navigator">
                &nbsp;&nbsp;&nbsp;
                <span>Way: Google Maps Store Locator</span>
            </div>
        </div>`;
        
        el.insertAdjacentHTML('afterbegin', warningHTML);
    });
}

function showAddStoreLocationsBanner() {
    document.querySelectorAll('[data-effectify-store-locator]').forEach((el) => {
        if (el.querySelector('.effectify-warning')) return; 
        
        const warningHTML = `
          <div class="upgrade-plan-warning">
            <div class="locator-banner-header">
                <span class="locator-banner-icons">
                    <svg viewBox="0 0 20 20" class="locator-icon-svg" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <path d="M6.75 8V6.5C6.75 4.70507 8.20507 3.25 10 3.25C11.7949 3.25 13.25 4.70507 13.25 6.5V8" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                        <rect x="4.75" y="8" width="10.5" height="8.75" rx="1.25" stroke="currentColor" stroke-width="1.5"/>
                    </svg>
                </span>
                <span class="locator-banner-notice">This banner is only visible to you</span>
            </div>

            <div class="locator-banner-content">
                <span class="locator-banner-label">Please add at least one store location to use this app block.</span>
            </div>
        </div>`;
        
        el.style.height = "auto";
        el.innerHTML = warningHTML;
    });
}

function initializeStoreDataStatic() {
    const locations = Array.isArray(settingsStatic.store_locations) ? settingsStatic.store_locations : [];

    storeLocationsStatic = locations.map((store) => ({
        ...store,
        latitude: store.latitude !== undefined && store.latitude !== null && store.latitude !== "" ? Number(store.latitude) : undefined,
        longitude: store.longitude !== undefined && store.longitude !== null && store.longitude !== "" ? Number(store.longitude) : undefined,
    }));

    storeIndexMapStatic = new Map();
    storeCoordinatesStatic = {};

    storeLocationsStatic.forEach((store) => {
        if (isFinite(store.latitude) && isFinite(store.longitude)) {
            storeCoordinatesStatic[store.id] = { lat: store.latitude, lng: store.longitude };
        }
    });

    const numberingOrderStatic = settingsStatic.nav_sort_alphabetically
        ? [...storeLocationsStatic].sort((a, b) => (a.name || "").localeCompare(b.name || "", undefined, {sensitivity: "base"}))
        : storeLocationsStatic;
    numberingOrderStatic.forEach((store, index) => {
        storeIndexMapStatic.set(store.id, index + 1);
    });

    filteredStoreLocationsStatic = [...storeLocationsStatic];

    if (settingsStatic.nav_expand_default) {
        storeLocationsStatic.forEach(store => {
            isExpandedStateStatic[store.id] = true;
        });
    }
}

function updateSearchCountStatic(invisible = false) {
    const countElement = document.getElementById("searchResultsCount-static");
    if (!countElement) return;
    if (invisible) {
        countElement.innerText = '';
    } else {
        countElement.innerText = `${settingsStatic.nav_search_text}: ${filteredStoreLocationsStatic.length}`;
    }
}


